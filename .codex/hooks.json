{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/python/map-guard.py\" --agent codex",
            "statusMessage": "map-guard"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/python/map-coach.py\" --agent codex",
            "statusMessage": "map-coach"
          }
        ]
      }
    ]
  }
}
